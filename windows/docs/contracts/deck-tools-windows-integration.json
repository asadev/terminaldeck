            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "remote.workspace",
      "wire": "remote_workspace",
      "tier": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "hoot": {
            "type": "boolean"
          },
          "access": {
            "type": "string",
            "enum": [
              "look",
              "work",
              "full"
            ]
          }
        },
        "required": [
          "deviceId"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "shell.read",
      "wire": "shell_read",
      "tier": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "commands",
              "sidebar",
              "quick-files",
              "session-search",
              "inspector"
