<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"><PrivateAssets>all</PrivateAssets></PackageReference>
    <ProjectReference Include="../../src/TerminalDeck.Core/TerminalDeck.Core.csproj" />
    <Using Include="Xunit" />
    <Compile Include="../../src/TerminalDeck.App/Services/UpdatePackagePath.cs" Link="Platform/UpdatePackagePath.cs" />
    <Compile Include="../../src/TerminalDeck.App/Views/Chat/RichChatDocument.cs" Link="Chats/RichChatDocument.cs" />
    <!-- Exercise the actual shared user-created launch method without starting the app or keeper. -->
    <Compile Include="../../src/TerminalDeck.App/Integration/LocalSessionStarts.cs" Link="Integration/LocalSessionStarts.cs" />
    <!-- Pure navigation/geometry contracts run on Mac without compiling the WinUI app. -->
    <Compile Include="../../src/TerminalDeck.App/Views/Settings/SettingsNavigation.cs" Link="Settings/SettingsNavigation.cs" />
    <Compile Include="../../src/TerminalDeck.App/Views/Settings/SettingsPanelBounds.cs" Link="Settings/SettingsPanelBounds.cs" />
    <Compile Include="../../src/TerminalDeck.App/Views/Settings/SettingsWindowPlacement.cs" Link="Settings/SettingsWindowPlacement.cs" />
    <!-- Lane U2: the Cloud screens' rules (side panel rows, Your Cloud's top bar, the Cloud chat page). -->
    <Compile Include="../../src/TerminalDeck.App/Views/Windows/SidebarCloudRows.cs" Link="CloudScreens/SidebarCloudRows.cs" />
    <Compile Include="../../src/TerminalDeck.App/Views/Settings/YourCloudRules.cs" Link="CloudScreens/YourCloudRules.cs" />
    <Compile Include="../../src/TerminalDeck.App/Views/Settings/DeviceKinds.cs" Link="CloudScreens/DeviceKinds.cs" />
    <Compile Include="../../src/TerminalDeck.App/Views/Chat/CloudChatRules.cs" Link="CloudScreens/CloudChatRules.cs" />
    <!-- M4 (review 25): the GPU encoder's lifetime helper is plain .NET; its tests run here. -->
    <Compile Include="../../src/TerminalDeck.Platform.Windows/Phone/EncoderEventThread.cs" Link="Remote/EncoderEventThread.cs" />
    <None Update="Fixtures/*.cjs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lane U3: the Bin page's rules (no screen needed). -->
    <Compile Include="../../src/TerminalDeck.App/Views/Settings/CloudBinRules.cs" Link="CloudBin/CloudBinRules.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- WhatsApp agents: the screens' rules (Settings rows, the submenu, the heading chip). -->
    <Compile Include="../../src/TerminalDeck.App/Views/WhatsApp/WhatsAppScreenRules.cs" Link="WhatsAppScreens/WhatsAppScreenRules.cs" />
  </ItemGroup>
</Project>
