<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>../../src/TerminalDeck.App/app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app's own code comes from the app project (it grows; a list of linked files went stale). -->
    <ProjectReference Include="../../src/TerminalDeck.App/TerminalDeck.App.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="../../src/TerminalDeck.Core/TerminalDeck.Core.csproj" />
    <ProjectReference Include="../../src/TerminalDeck.Platform.Windows/TerminalDeck.Platform.Windows.csproj" />
    <Page Include="../../src/TerminalDeck.App/Styles/DeckResources.xaml" Link="Styles/DeckResources.xaml" />
    <Content Include="../../src/TerminalDeck.App/Assets/icons/hoot.svg" Link="Assets/icons/hoot.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
