<Application x:Class="TerminalDeck.ProjectsAgents.Proof.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="Styles/DeckResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="SurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DeckCardBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
