    <UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType><ApplicationManifest>../../src/TerminalDeck.App/app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms><RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
