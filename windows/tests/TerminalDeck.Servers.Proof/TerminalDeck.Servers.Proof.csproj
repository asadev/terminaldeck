    <ProjectReference Include="../../src/TerminalDeck.Core/TerminalDeck.Core.csproj" />
    <ProjectReference Include="../../src/TerminalDeck.Platform.Windows/TerminalDeck.Platform.Windows.csproj" />
    <Compile Include="../../src/TerminalDeck.App/Views/Servers/*.cs" Link="Views/Servers/%(Filename)%(Extension)" />
