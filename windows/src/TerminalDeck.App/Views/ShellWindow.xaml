<Window x:Class="TerminalDeck.App.Views.ShellWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:TerminalDeck.App.Views"
 xmlns:notices="using:TerminalDeck.App.Views.Notices">
 <Grid x:Name="Root" Background="Transparent">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="264"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid x:Name="SidebarPanel" Grid.Row="1" Background="Transparent" Padding="12,8,12,0" RowSpacing="0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="BrandLabel" Visibility="Collapsed"/>
   <ScrollViewer Grid.Row="1" Grid.RowSpan="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"><StackPanel Spacing="8">
   <StackPanel x:Name="NavigationRoutes" Spacing="4">
    <Button HorizontalAlignment="Stretch" Style="{StaticResource DeckSidebarActionStyle}" Click="NewSession_Click" AutomationProperties.Name="New session"><StackPanel Orientation="Horizontal" Spacing="8"><views:DeckIcon Glyph="compose" FontSize="16"/><TextBlock Text="New session"/></StackPanel></Button>
    <ToggleButton Tag="Hoot" HorizontalAlignment="Stretch" Style="{StaticResource DeckNavigationButtonStyle}" Click="Hoot_Click" AutomationProperties.Name="Hoot"><StackPanel Orientation="Horizontal" Spacing="8"><Image Width="16" Height="16" AutomationProperties.AccessibilityView="Raw"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/icons/hoot.svg"/></Image.Source></Image><TextBlock Text="Hoot"/></StackPanel></ToggleButton>
    <StackPanel x:Name="PinnedPageRows" Spacing="4"/>
    <Button x:Name="MorePages" Click="MorePages_Click" Style="{StaticResource DeckSidebarActionStyle}" HorizontalAlignment="Stretch" AutomationProperties.Name="More pages"><StackPanel Orientation="Horizontal" Spacing="8"><views:DeckIcon Glyph="&#xE76C;" FontSize="14"/><TextBlock Text="More"/></StackPanel></Button>
   </StackPanel>
   <StackPanel x:Name="ProjectsSection" Spacing="4">
    <Grid Margin="8,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ToggleButton x:Name="ProjectsRoute" Tag="Projects" Click="Projects_Click" Style="{StaticResource DeckNavigationButtonStyle}" Content="Projects" FontSize="12" Padding="0" AutomationProperties.Name="Projects"/>
     <Button Grid.Column="1" Click="NewProject_Click" Style="{StaticResource DeckToolbarButtonStyle}" AutomationProperties.Name="New project" ToolTipService.ToolTip="New project"><views:DeckIcon Glyph="&#xE710;" FontSize="12"/></Button>
    </Grid>
    <StackPanel x:Name="ProjectRows" Spacing="2"/>
   </StackPanel>
   <Grid RowSpacing="4">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Running" Margin="8,8,0,0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <ListView Grid.Row="1" x:Name="SessionList" SelectionMode="Single" AutomationProperties.Name="Sessions" SelectionChanged="SessionList_SelectionChanged" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">

     <ListView.Resources>
      <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="DeckTransparentBrush"/>
      <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="DeckTransparentBrush"/>
      <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="DeckTransparentBrush"/>
      <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="DeckSidebarSelectionInkBrush"/>
      <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="DeckSidebarSelectionInkBrush"/>
      <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="DeckSidebarSelectionInkBrush"/>
      <StaticResource x:Key="ListViewItemSelectionIndicatorBrush" ResourceKey="DeckTransparentBrush"/>
     </ListView.Resources>
     <ListView.ItemTemplate><DataTemplate>
      <views:SidebarSessionRow ColumnSpacing="8" Padding="8,3" Height="44" MinHeight="44" AutomationProperties.Name="{Binding Label}" ToolTipService.ToolTip="{Binding Folder}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
       <views:SessionPicture Grid.Column="1" Session="{Binding}" Width="28" Height="28" Margin="0,0,6,6" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <TextBlock Tag="SessionSubtitle" Text="{Binding DisplaySubtitle}" FontSize="11" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <Button Grid.Column="3" Click="SessionActions_Click" Padding="2" MinWidth="22" Width="22" Height="28" MinHeight="0" Background="Transparent" AutomationProperties.Name="Session actions"><views:DeckIcon Glyph="&#xE712;" FontSize="12"/></Button>
       <views:SessionStatusMark State="{Binding State}" Unread="{Binding Unread}" VerticalAlignment="Center"/>
      </views:SidebarSessionRow>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel x:Name="ArchivedSessions" Grid.Row="3" Visibility="Collapsed" Spacing="4">
     <Button x:Name="ArchivedChatsToggle" Content="Archived chats" Click="ArchivedChats_Click" Style="{StaticResource DeckSidebarActionStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12"/>
     <StackPanel x:Name="ArchivedChatRows" Visibility="Collapsed"/>
     <Grid Visibility="Collapsed">
     <ListView x:Name="ArchivedSessionList" ItemTemplate="{Binding ItemTemplate, ElementName=SessionList}" SelectionMode="Single" SelectionChanged="ArchivedSessionList_SelectionChanged" HorizontalContentAlignment="Stretch" Background="Transparent" AutomationProperties.Name="Archived sessions"/>
     </Grid>
    </StackPanel>
    <TextBlock Grid.Row="2" x:Name="EmptySidebar" Text="New sessions appear here." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/>
   </Grid>
   </StackPanel></ScrollViewer>
   <!-- Release 27: a newer GitHub release, just above Settings (ShellUpdates.cs fills it; hidden while there is none). -->
   <Border x:Name="UpdateCard" Grid.Row="3" Visibility="Collapsed" Margin="0,4,0,6" Padding="10" CornerRadius="10" AutomationProperties.Name="Update"/>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="SettingsRoute" Click="Settings_Click" HorizontalAlignment="Stretch" Style="{StaticResource DeckSidebarActionStyle}" Height="44" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal" Spacing="8"><views:DeckIcon Glyph="{StaticResource DeckIconSettings}" FontSize="16"/><TextBlock Text="Settings"/></StackPanel></Button>
    <Button x:Name="DevicesButton" Grid.Column="1" Click="Devices_Click" Width="40" Height="40" Padding="6" Style="{StaticResource DeckSidebarActionStyle}" AutomationProperties.Name="Devices" ToolTipService.ToolTip="Devices"><views:DeckIcon Glyph="devices" FontSize="16"/></Button>
   </Grid>
  </Grid>
  <Grid Grid.ColumnSpan="2" Background="Transparent" x:Name="TitleBarRow" ColumnSpacing="4">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="TitleSidebarColumn" Width="264"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="48"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,0,4,0" VerticalAlignment="Center">
   <Button x:Name="SidebarToggle" HorizontalAlignment="Left" Style="{StaticResource DeckToolbarButtonStyle}" Click="SidebarToggle_Click" Margin="0" AutomationProperties.Name="Toggle sidebar" ToolTipService.ToolTip="Toggle sidebar (Ctrl+Shift+S)"><views:DeckIcon Glyph="&#xE8A0;" FontSize="16"/></Button>

   </StackPanel>
   <Grid Grid.Column="1" MinWidth="0">
    <TextBlock x:Name="PageTitle" FontSize="13" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <ContentControl x:Name="WorkspaceHeader" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
   </Grid>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
    <Button x:Name="AccountChip" Visibility="Collapsed" Content="Accounts" Click="Account_Click"/>
   </StackPanel>
   <Grid x:Name="TitleDragRegion" Grid.Column="3" Background="Transparent"/>
   <Grid x:Name="CaptionSpace" Grid.Column="4" Width="138"/>
  </Grid>
  <Grid Grid.Row="1" Grid.Column="1" x:Name="ContentCard" Background="{ThemeResource DeckCanvasBrush}" CornerRadius="12,0,0,0" Margin="0">
   <Grid x:Name="Workspace"/>
   <notices:CompactNotice x:Name="Status"/>
  </Grid>
  <!-- Last child and Raw: the hidden 1x1 browser engine must not cut the rest of the window out of the UI Automation tree (screen readers, test drivers). -->
  <Grid x:Name="BrowserEngineHost" Grid.Row="1" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw"/>
 </Grid>
</Window>
