<UserControl x:Class="TerminalDeck.App.Views.Settings.CloudPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AutomationProperties.AutomationId="settings.cloud">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
  <StackPanel MaxWidth="640" Spacing="12" Margin="20,0,20,20" HorizontalAlignment="Center">
   <Border Height="52"><TextBlock x:Name="Heading" Text="Cloud" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>

   <!-- Top card. Signed out: one line and a modest Sign in. Signed in: name, e-mail, provider and Sign out. -->
   <Border x:Name="AccountCard" Background="{ThemeResource DeckCardBrush}" CornerRadius="10" Padding="12,10">
    <Grid ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="3" VerticalAlignment="Center">
      <TextBlock x:Name="AccountName" FontSize="13" TextWrapping="Wrap"/>
      <TextBlock x:Name="AccountEmail" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource DeckSecondaryInkBrush}"/>
      <TextBlock x:Name="AccountProvider" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource DeckSecondaryInkBrush}"/>
     </StackPanel>
     <Button x:Name="AccountButton" Grid.Column="1" VerticalAlignment="Center" MinHeight="28" Padding="12,3" FontSize="13" Click="AccountButton_Click"/>
    </Grid>
   </Border>

   <!-- Signed in: this PC, then the account's devices. -->
   <StackPanel x:Name="CloudSection" Spacing="12" Visibility="Collapsed">
    <Border Background="{ThemeResource DeckCardBrush}" CornerRadius="10" Padding="12,10">
     <StackPanel Spacing="3">
      <TextBlock x:Name="CloudLine" FontSize="13" TextWrapping="Wrap"/>
      <TextBlock x:Name="ThisDevice" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource DeckSecondaryInkBrush}"/>
     </StackPanel>
    </Border>
    <!-- Joining is automatic: one switch, on after sign-in. -->
    <Border Background="{ThemeResource DeckCardBrush}" CornerRadius="10" Padding="12,10">
     <StackPanel Spacing="3">
      <ToggleSwitch x:Name="UseCloudSwitch" Header="Use Cloud on this PC" OnContent="" OffContent="" Toggled="UseCloudSwitch_Toggled"/>
      <TextBlock x:Name="UseCloudState" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource DeckSecondaryInkBrush}"/>
     </StackPanel>
    </Border>
    <TextBlock x:Name="DevicesHeading" Text="Devices" FontSize="13" FontWeight="SemiBold" Margin="8,8,0,0"/>
    <StackPanel x:Name="DeviceList" Spacing="8"/>
   </StackPanel>

   <TextBlock x:Name="Problem" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource DeckSecondaryInkBrush}" Visibility="Collapsed"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
