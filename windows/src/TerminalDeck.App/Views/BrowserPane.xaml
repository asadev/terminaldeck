<UserControl x:Class="TerminalDeck.App.Views.BrowserPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TerminalDeck.App.Views">
 <Grid RowSpacing="0" Background="{ThemeResource DeckCanvasBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer Padding="12,4" Background="{ThemeResource DeckRailBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"><StackPanel x:Name="TabRail" Orientation="Horizontal" Spacing="4"/></ScrollViewer>
  <Grid Grid.Row="1" ColumnSpacing="8" Padding="12,6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="2"><Button x:Name="Back" Style="{StaticResource DeckToolbarButtonStyle}" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back" Click="Back_Click"><local:DeckIcon Glyph="&#xE72B;" FontSize="14"/></Button><Button x:Name="Forward" Style="{StaticResource DeckToolbarButtonStyle}" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward" Click="Forward_Click"><local:DeckIcon Glyph="&#xE72A;" FontSize="14"/></Button><Button x:Name="Reload" Style="{StaticResource DeckToolbarButtonStyle}" AutomationProperties.Name="Reload page" ToolTipService.ToolTip="Reload page" Click="Reload_Click"><local:DeckIcon x:Name="ReloadIcon" Glyph="&#xE72C;" FontSize="14"/></Button></StackPanel>
   <TextBox x:Name="Address" Grid.Column="1" CornerRadius="18" Padding="14,6" VerticalAlignment="Center" Background="{ThemeResource DeckControlBrush}" BorderThickness="0" PlaceholderText="Enter a URL, or search" KeyDown="Address_KeyDown" AutomationProperties.Name="Web address"/>
   <Button Grid.Column="2" x:Name="ProfileButton" Width="36" Height="36" Padding="0" CornerRadius="18" Content="D" Click="Profiles_Click" AutomationProperties.Name="Browser profile"/>
  </Grid>

  <Border Grid.Row="3" x:Name="RecordedPanel" Visibility="Collapsed" Background="{ThemeResource DeckRailBrush}" Padding="12,8">
   <StackPanel Spacing="8">
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="RecordedHeading" Text="Recorded steps" VerticalAlignment="Center" FontWeight="SemiBold"/>
     <Button Grid.Column="1" x:Name="CopyStepsButton" Content="Copy" Click="CopySteps_Click"/>
     <Button Grid.Column="2" x:Name="ClearStepsButton" Content="Clear" Click="ClearSteps_Click"/>
     <Button Grid.Column="3" Style="{StaticResource DeckToolbarButtonStyle}" AutomationProperties.Name="Hide recorded steps" Click="HideSteps_Click"><local:DeckIcon Glyph="&#xE711;" FontSize="12"/></Button>
    </Grid>
    <ScrollViewer MaxHeight="130" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="RecordedText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/></ScrollViewer>
   </StackPanel>
  </Border>
  <Grid Grid.Row="4" x:Name="SurfaceHost" Background="{ThemeResource DeckCardBrush}">
   <ProgressRing x:Name="Pending" IsActive="False" Width="32" Height="32"/>
  </Grid>
  <Border Grid.Row="4" x:Name="HandoverBar" Visibility="Collapsed" Style="{ThemeResource SurfaceCardStyle}" Padding="12" Margin="12" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="392" Canvas.ZIndex="10">
   <StackPanel Spacing="8"><TextBlock x:Name="HandoverPrompt" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Carry on" Click="HandoverContinue_Click"/><Button Content="Stop" Click="HandoverStop_Click"/></StackPanel></StackPanel>
  </Border>
  <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" HorizontalContentAlignment="Center" Padding="12,8">
   <Border Background="{ThemeResource DeckGlassBrush}" CornerRadius="22" Padding="6,4">
    <StackPanel Orientation="Horizontal" Spacing="2">
     <Button Click="Inspect_Click" AutomationProperties.Name="Annotate" ToolTipService.ToolTip="Pick an element to annotate"><StackPanel Orientation="Horizontal" Spacing="6"><local:DeckIcon Glyph="&#xE943;" FontSize="14"/><TextBlock Text="Annotate"/></StackPanel></Button>
     <Button Click="Size_Click" AutomationProperties.Name="Size"><StackPanel Orientation="Horizontal" Spacing="6"><local:DeckIcon Glyph="&#xE8EA;" FontSize="14"/><TextBlock Text="Size"/></StackPanel></Button>
     <Button Click="Send_Click" AutomationProperties.Name="Send"><StackPanel Orientation="Horizontal" Spacing="6"><local:DeckIcon Glyph="&#xE724;" FontSize="14"/><TextBlock Text="Send"/></StackPanel></Button>
     <Button x:Name="RecordButton" Click="Record_Click" AutomationProperties.Name="Record"><StackPanel Orientation="Horizontal" Spacing="6"><local:DeckIcon x:Name="RecordIcon" Glyph="&#xEA3A;" FontSize="14"/><TextBlock x:Name="RecordLabel" Text="Record"/></StackPanel></Button>
     <Button Click="Steps_Click" AutomationProperties.Name="Recorded steps"><StackPanel Orientation="Horizontal" Spacing="6"><local:DeckIcon Glyph="&#xE8A5;" FontSize="14"/><TextBlock x:Name="StepsLabel" Text="Steps"/></StackPanel></Button>
    </StackPanel>
   </Border>
  </ScrollViewer>
  <TextBlock Grid.Row="4" x:Name="BrowserStatus" Visibility="Collapsed" Margin="12,0,12,4" Text="Opening browser…" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
 </Grid>
</UserControl>
