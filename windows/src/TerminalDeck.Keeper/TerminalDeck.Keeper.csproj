<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TerminalDeck.ToolBridge/TerminalDeck.ToolBridge.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tests/TerminalDeck.Servers.Askpass/TerminalDeck.Servers.Askpass.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TerminalDeck.Core/TerminalDeck.Core.csproj" />
    <ProjectReference Include="../TerminalDeck.Platform.Windows/TerminalDeck.Platform.Windows.csproj" />
  </ItemGroup>
  <Target Name="CopyToolHelpers" AfterTargets="Build">
    <ItemGroup>
      <BridgeFiles Include="../TerminalDeck.ToolBridge/bin/$(Platform)/$(Configuration)/net10.0-windows10.0.19041.0/*" />
      <AskpassFiles Include="../../tests/TerminalDeck.Servers.Askpass/bin/$(Platform)/$(Configuration)/net10.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeFiles)" DestinationFolder="$(OutDir)tools-bridge" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AskpassFiles)" DestinationFolder="$(OutDir)askpass" SkipUnchangedFiles="true" />
  </Target>
</Project>
