<?xml version="1.0" encoding="utf-8"?>
<!-- Application/Extensions contribution. The packaging owner inserts this in
     the MSIX manifest; the unpackaged preview cannot register a share target. -->
<uap:Extension xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
               xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
               Category="windows.shareTarget">
  <uap:ShareTarget uap10:DisplayName="Send to Terminal Deck" Description="Save to Receiver for review">
    <uap:SupportedFileTypes><uap:SupportsAnyFileType /></uap:SupportedFileTypes>
    <uap:DataFormat>Text</uap:DataFormat>
    <uap:DataFormat>WebLink</uap:DataFormat>
    <uap:DataFormat>Bitmap</uap:DataFormat>
    <uap:DataFormat>StorageItems</uap:DataFormat>
  </uap:ShareTarget>
</uap:Extension>
