<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><UseWindowsForms>true</UseWindowsForms><PlatformTarget>x64</PlatformTarget></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Browser/TerminalDeck.Windows.Browser.csproj" /></ItemGroup>
  <Target Name="UseOnlyNativeWebView2Core" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Reference.Identity)').EndsWith('Microsoft.Web.WebView2.Wpf.dll')) Or $([System.String]::Copy('%(Reference.Identity)').EndsWith('Microsoft.Web.WebView2.WinForms.dll'))" /></ItemGroup>
  </Target>
</Project>
