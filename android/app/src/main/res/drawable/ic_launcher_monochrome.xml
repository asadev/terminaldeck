<!--
  The themed-icon layer: one silhouette, which the launcher fills with the wallpaper's own colour.

  The card and the spine cannot be in it — a monochrome layer is a stencil, and a filled rounded
  rectangle stencilled in one colour is a blob. What survives is the part of the mark that is still
  the mark at 16 pixels in a single ink: the prompt.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,42 L54,54 L40,66" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M61,59 h16 v7 h-16 z" />
</vector>
