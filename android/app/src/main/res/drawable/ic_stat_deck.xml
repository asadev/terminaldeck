<?xml version="1.0" encoding="utf-8"?>
<!--
  The notification icon: a shell prompt — a chevron and a caret.

  White on transparent, and nothing else. Android takes the alpha channel of a status-bar icon and
  throws the colour away, so an icon drawn in the brand green arrives as a green-shaped silhouette
  in whatever tint the system picks; drawing it white is what makes it legible in both the light and
  the dark status bar. It is deliberately not `ic_launcher_foreground` scaled down: that mark has an
  enclosing shape, and an enclosing shape at 24dp flattens to a filled square.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.8,5.6 L6.4,4 L13.2,10.8 A1.7,1.7 0 0 1 13.2,13.2 L6.4,20 L4.8,18.4 L11.2,12 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.5,17.8 L20.4,17.8 L20.4,20 L12.5,20 Z" />
</vector>
