<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The socket. Terminal Deck reaches a Mac through the rendezvous relay; it does not read
      contacts, files or location, and a terminal client that asked for any of those would deserve
      the suspicion it got.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      There is deliberately no CAMERA permission. This app carried one for the pairing QR code, and
      the QR did not work; pairing is now six digits somebody reads off the machine and types, and
      `QRScanner` and the ZXing dependency went with it. A permission for a capability the binary
      does not exercise is something Play asks about on every release and something a user is right
      to be suspicious of, so it goes with the code that needed it.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TerminalDeck">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TerminalDeck"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              There is deliberately no `terminaldeck://pair` filter.

              One used to be here, so that a link out of a QR code or a message could open this app
              already holding a pairing token. The QR did not work and the link was the problem
              rather than the delivery: it is a live single-use bearer secret in a string, whose only
              route to a phone is a messaging app that keeps a copy — and any app on the device may
              claim a custom scheme, so it was a secret handed to whoever answered first.

              Pairing is six digits typed into this app now. There is no second door and nothing
              arrives from outside the process, which is a smaller surface than any amount of
              validation on the way in.
            -->
        </activity>
    </application>

</manifest>
