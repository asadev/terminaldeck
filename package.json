{
  "name": "terminaldeck",
  "version": "0.1.7",
  "description": "Run your coding agents on one deck — sessions, browsers, cost and context in a single window.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Asad Iqbal",
    "url": "https://terminaldeck.dev"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:pwa": "npm --prefix pwa ci && npm --prefix pwa run build",
    "preview": "electron-vite preview",
    "test": "vitest run && npm run test:electron",
    "test:electron": "node scripts/check-electron-crypto.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps",
    "art": "node build/art/icon.mjs && iconutil -c icns build/icon.iconset -o build/icon.icns && node build/art/dmg-background.mjs",
    "dist:mac": "npm run build && npm run build:pwa && electron-builder --mac --publish never",
    "dist:win": "npm run build && npm run build:pwa && electron-builder --win --publish never",
    "pack:mac": "npm run build && npm run build:pwa && electron-builder --mac dir:arm64 --publish never",
    "release:check": "node scripts/check-release.mjs",
    "preversion": "npm run typecheck && npm test && node scripts/version.mjs check",
    "version": "node scripts/version.mjs stamp && git add CHANGELOG.md",
    "postversion": "node scripts/version.mjs next"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "out"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@noble/ciphers": "2.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "dompurify": "^3.3.3",
    "electron-updater": "^6.8.3",
    "gridstack": "^12.6.0",
    "marked": "^17.0.5",
    "node-pty": "^1.1.0",
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/picomatch": "^4.0.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "productName": "Terminal Deck",
  "homepage": "https://terminaldeck.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/asadev/terminaldeck.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai-agents",
    "terminal",
    "ide",
    "electron",
    "codex",
    "gemini",
    "coding-agent",
    "developer-tools"
  ]
}
